{
  "name": "taskflow-pro",
  "version": "26.0.0",
  "description": "TaskFlow Pro+ Ultra Native Desktop & Mobile Fitness/Discipline Suite",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "prepare-www": "node scripts/prepare-www.js",
    "cap-sync": "node scripts/prepare-www.js && cap sync android"
  },
  "build": {
    "appId": "com.taskflow.pro",
    "productName": "TaskFlow Pro+",
    "win": {
      "target": "portable",
      "icon": "icon-512.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "index.html",
      "styles.css",
      "app.js",
      "fit_recipes_data.js",
      "assets/**/*",
      "icon*.png",
      "favicon.ico",
      "icon.ico",
      "package.json"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperkoks/taskflow-pro.git"
  },
  "keywords": [
    "fitness",
    "discipline",
    "health",
    "calories",
    "water",
    "nutrition"
  ],
  "author": "TaskFlow Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.18.0"
  }
}